@page "/admin/login"
@model RachelTower.Web.Pages.Admin.LoginModel
@{
    ViewData["Title"] = L["Admin.Login.Title"];
}

<div class="mx-auto mt-10 max-w-sm">
    <h1 class="font-display text-4xl font-semibold">@L["Admin.Login.Title"]</h1>
    <form method="post" class="mt-8 space-y-5 rounded bg-white p-6 shadow-sm ring-1 ring-stone-200" novalidate>
        @if (Model.Error is not null)
        {
            <p class="rounded border border-red-200 bg-red-50 p-3 text-sm text-red-900" role="alert">@Model.Error</p>
        }
        <input type="hidden" asp-for="ReturnUrl" />
        <div>
            <label asp-for="Input.Email" class="form-label"></label>
            <input asp-for="Input.Email" type="email" class="form-input" autocomplete="username" autofocus required />
            <span asp-validation-for="Input.Email" class="form-error"></span>
        </div>
        <div>
            <label asp-for="Input.Password" class="form-label"></label>
            <input asp-for="Input.Password" class="form-input" autocomplete="current-password" required />
            <span asp-validation-for="Input.Password" class="form-error"></span>
        </div>
        <label class="flex items-center gap-2 text-sm">
            <input asp-for="Input.Remember" class="h-4 w-4 accent-gold-600" />
            @L["Admin.Login.Remember"]
        </label>
        <button type="submit" class="btn-primary w-full justify-center">@L["Admin.Login.Submit"]</button>
    </form>
</div>
