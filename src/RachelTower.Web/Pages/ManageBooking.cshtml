@page
@model ManageBookingModel
@using System.Globalization
@using Microsoft.Extensions.Options
@using RachelTower.Web.Data
@using RachelTower.Web.Reservations
@inject HotelClock Clock
@inject IOptions<BookingOptions> Rules
@{
    var b = Model.Booking;
    ViewData["Title"] = string.Format(L["Manage.Title"], b.Reference);
    ViewData["Description"] = L["Book.MetaDescription"];
    var hotel = HotelSettings.Value;
    var culture = SiteCultures.Current;
    var ci = CultureInfo.CurrentCulture;
    var deadline = Clock.ToLocal(Model.CancellationDeadline).ToString("dddd d MMMM yyyy, HH:mm", ci);
    var statusClass = b.Status switch
    {
        BookingStatus.Confirmed or BookingStatus.CheckedIn => "bg-emerald-50 text-emerald-800 ring-emerald-200",
        BookingStatus.PendingPayment => "bg-amber-50 text-amber-800 ring-amber-200",
        BookingStatus.CheckedOut => "bg-sand text-ink ring-sand",
        _ => "bg-red-50 text-red-800 ring-red-200",
    };
}

<section class="mx-auto max-w-3xl px-5 pb-20 pt-12 lg:pt-16">
    @if (Model.JustCreated)
    {
        <div class="mb-8 rounded-sm border border-emerald-200 bg-emerald-50 p-5 text-emerald-900" role="status">
            <p class="font-medium">@L["Manage.Created"]</p>
            @if (b.GuestEmail is not null)
            {
                <p class="mt-1 text-sm">@string.Format(L["Manage.CreatedEmail"], b.GuestEmail)</p>
            }
        </div>
    }
    @if (Model.Message == "cancelled")
    {
        <p class="mb-8 rounded-sm border border-sand bg-white p-5" role="status">@L["Manage.Cancelled"]</p>
    }
    else if (Model.Message is not null)
    {
        <p class="mb-8 rounded-sm border border-red-200 bg-red-50 p-5 text-red-900" role="alert">@Model.Message</p>
    }

    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <p class="eyebrow text-gold-600">@L["Booking.Reference"]</p>
            <h1 class="mt-1 font-display text-5xl font-semibold tracking-wide">@b.Reference</h1>
        </div>
        <span class="rounded-full px-4 py-1.5 text-sm font-medium ring-1 @statusClass">@L[$"Status.{b.Status}"]</span>
    </div>

    <article class="mt-8 overflow-hidden rounded-sm bg-white shadow-sm ring-1 ring-sand">
        <div class="grid sm:grid-cols-[14rem_1fr]">
            <img src="@Images.Src(SiteImages.ByKey(b.RoomType.ImageKey), 600)" alt="@b.RoomType.Name(culture)" class="h-full min-h-40 w-full object-cover" />
            <div class="p-6">
                <h2 class="font-display text-3xl font-semibold">@b.RoomType.Name(culture)</h2>
                <dl class="mt-4 grid grid-cols-2 gap-x-6 gap-y-3 text-sm">
                    <div><dt class="text-ink/60">@L["Book.CheckIn"]</dt><dd class="font-medium">@b.CheckIn.ToString("D", ci)</dd></div>
                    <div><dt class="text-ink/60">@L["Book.CheckOut"]</dt><dd class="font-medium">@b.CheckOut.ToString("D", ci)</dd></div>
                    <div><dt class="text-ink/60">@L["Booking.Nights"]</dt><dd class="font-medium">@b.Nights</dd></div>
                    <div><dt class="text-ink/60">@L["Book.Guests"]</dt><dd class="font-medium">@b.Guests</dd></div>
                    <div><dt class="text-ink/60">@L["Booking.Guest"]</dt><dd class="font-medium">@b.GuestName</dd></div>
                    <div><dt class="text-ink/60">@L["Booking.Phone"]</dt><dd class="font-medium">@b.GuestPhone</dd></div>
                </dl>
            </div>
        </div>
        <div class="flex flex-wrap items-baseline justify-between gap-3 border-t border-sand px-6 py-5">
            <div>
                <p class="font-medium">@L["Booking.Total"]</p>
                <p class="text-sm text-ink/70">@L[$"Payment.{b.PaymentMethod}"] (@L[$"PaymentStatus.{b.PaymentStatus}"])</p>
            </div>
            <p class="font-display text-3xl font-semibold">@Money.Usd(b.TotalUsd, ci)</p>
        </div>
        @if (b.IsActive && b.PaymentMethod == PaymentMethod.PayAtDesk && b.PaymentStatus == PaymentStatus.Unpaid && Rules.Value.ReleaseUnpaidAtHour is { } hour)
        {
            <p class="border-t border-sand bg-ivory px-6 py-4 text-sm text-ink/80">@string.Format(L["Booking.PayAtDeskNote"], $"{hour}:00")</p>
        }
    </article>

    @if (b.IsActive)
    {
        <section class="mt-10 rounded-sm border border-sand p-6">
            <h2 class="font-display text-2xl font-semibold">@L["Manage.CancelTitle"]</h2>
            @if (Model.CanCancel)
            {
                <p class="mt-2 text-ink/80">@string.Format(L["Manage.CancelUntil"], deadline)</p>
                <form method="post" asp-page-handler="Cancel" class="mt-5 flex flex-col gap-4 sm:flex-row sm:items-center">
                    <label class="flex items-center gap-2 text-sm">
                        <input type="checkbox" name="confirm" value="true" required class="h-4 w-4 accent-gold-600" />
                        @L["Manage.CancelCheck"]
                    </label>
                    <button type="submit" class="btn-outline">@L["Manage.CancelButton"]</button>
                </form>
            }
            else
            {
                <p class="mt-2 text-ink/80">@L["Manage.CannotCancel"]</p>
            }
        </section>
    }

    <p class="mt-10 text-ink/70">
        @string.Format(L["Manage.Contact"], hotel.Phones.FirstOrDefault())
        <a class="link-plain" href="@hotel.WhatsAppUrl($"{b.Reference}: ")" target="_blank" rel="noopener">WhatsApp</a>.
    </p>
</section>
