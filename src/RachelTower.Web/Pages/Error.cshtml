@page "/Error/{code:int?}"
@model ErrorModel
@{
    var notFound = Model.Code == 404;
    ViewData["Title"] = $"{(notFound ? L["Error.NotFoundTitle"] : L["Error.GenericTitle"])} | The Rachel Tower";
}

<section class="mx-auto flex min-h-[60vh] max-w-2xl flex-col items-center justify-center px-5 py-24 text-center">
    <p class="eyebrow text-gold-600">@(Model.Code ?? 500)</p>
    <h1 class="mt-3 font-display text-5xl font-semibold">@(notFound ? L["Error.NotFoundTitle"] : L["Error.GenericTitle"])</h1>
    <p class="mt-4 text-lg text-ink/75">@(notFound ? L["Error.NotFoundText"] : L["Error.GenericText"])</p>
    <a href="@Url.PageIn("/Index")" class="btn-primary mt-8">@L["Error.BackHome"]</a>
</section>
