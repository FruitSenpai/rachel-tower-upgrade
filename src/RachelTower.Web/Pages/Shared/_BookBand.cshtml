@* Call-to-action band shown at the bottom of most pages. *@
<section class="bg-sand">
    <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 px-5 py-14 md:flex-row md:items-center lg:px-8">
        <div>
            <h2 class="font-display text-3xl font-semibold sm:text-4xl">@L["Home.BookBandTitle"]</h2>
            <p class="mt-2 max-w-xl text-ink/75">@L["Home.BookBandText"]</p>
        </div>
        <div class="flex flex-wrap gap-3">
            <a href="@Url.PageIn("/Book")" class="btn-primary">@L["Home.CtaBook"]</a>
            <a href="@HotelOptions.TelUrl(HotelSettings.Value.Phones.FirstOrDefault() ?? "")" class="btn-outline">@L["Common.Call"] @HotelSettings.Value.Phones.FirstOrDefault()</a>
        </div>
    </div>
</section>
