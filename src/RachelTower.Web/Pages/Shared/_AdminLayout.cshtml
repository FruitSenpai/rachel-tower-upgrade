@using System.Globalization
@{
    var culture = SiteCultures.Current;
    var other = SiteCultures.Other(culture);
    var signedIn = User.Identity?.IsAuthenticated == true;
    var current = ViewContext.RouteData.Values["page"] as string ?? "";
    var nav = new (string Page, string Href, string Label)[]
    {
        ("/Admin/Index", "/admin", L["Admin.Nav.Dashboard"]),
        ("/Admin/Calendar", "/admin/calendar", L["Admin.Nav.Calendar"]),
        ("/Admin/Bookings/Index", "/admin/bookings", L["Admin.Nav.Bookings"]),
        ("/Admin/Bookings/New", "/admin/bookings/new", L["Admin.Nav.New"]),
        ("/Admin/Rooms", "/admin/rooms", L["Admin.Nav.Rooms"]),
    };
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="@culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] | @L["Admin.Title"] · The Rachel Tower</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" />
</head>
<body class="min-h-screen bg-stone-50 font-sans text-ink antialiased">
    <header class="bg-ink text-white">
        <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-8 gap-y-3 px-5 py-4 lg:px-8">
            <a href="/admin" class="font-display text-xl font-semibold uppercase tracking-[0.15em]">The Rachel Tower <span class="ml-1 font-sans text-xs font-medium normal-case tracking-normal text-gold-300">@L["Admin.Title"]</span></a>
            @if (signedIn)
            {
                <nav class="order-last w-full overflow-x-auto lg:order-none lg:w-auto">
                    <ul class="flex gap-1 text-sm">
                        @foreach (var item in nav)
                        {
                            var active = current == item.Page || (item.Page == "/Admin/Bookings/Index" && current == "/Admin/Bookings/Details");
                            <li><a href="@item.Href" class="block whitespace-nowrap rounded px-3 py-2 @(active ? "bg-white/15 text-white" : "text-white/75 hover:bg-white/10 hover:text-white")" aria-current="@(active ? "page" : null)">@item.Label</a></li>
                        }
                    </ul>
                </nav>
            }
            <div class="ml-auto flex items-center gap-4 text-sm">
                <a href="/admin/language?c=@other&returnUrl=@Uri.EscapeDataString(returnUrl)" class="text-white/75 hover:text-white" lang="@other">@L["Admin.Language"]</a>
                <a href="/@culture" class="hidden text-white/75 hover:text-white sm:inline" target="_blank" rel="noopener">@L["Admin.Nav.Site"]</a>
                @if (signedIn)
                {
                    <form method="post" action="/admin/login?handler=Logout">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="rounded border border-white/30 px-3 py-1.5 hover:bg-white hover:text-ink">@L["Admin.SignOut"]</button>
                    </form>
                }
            </div>
        </div>
    </header>

    <main class="mx-auto max-w-7xl px-5 py-8 lg:px-8">
        @if (TempData["AdminMessage"] is string message)
        {
            <p class="mb-6 rounded border border-emerald-200 bg-emerald-50 px-4 py-3 text-emerald-900" role="status">@message</p>
        }
        @if (TempData["AdminError"] is string error)
        {
            <p class="mb-6 rounded border border-red-200 bg-red-50 px-4 py-3 text-red-900" role="alert">@error</p>
        }
        @RenderBody()
    </main>
</body>
</html>
