@model PageHeaderModel
@* Intro band at the top of inner pages: photo background, eyebrow, heading. *@
<section class="relative isolate overflow-hidden bg-ink">
    <img src="@Images.Src(Model.Image, 1920)" alt="" class="absolute inset-0 -z-10 h-full w-full object-cover opacity-45" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink/90 via-ink/40 to-ink/20"></div>
    <div class="mx-auto max-w-7xl px-5 pb-16 pt-28 lg:px-8 lg:pb-20 lg:pt-36">
        <p class="eyebrow text-gold-300">@Model.Eyebrow</p>
        <h1 class="mt-3 max-w-3xl font-display text-4xl font-semibold leading-tight text-white sm:text-5xl lg:text-6xl">@Model.Heading</h1>
    </div>
</section>
